# ==============================================================================
# Variáveis de Ambiente — RosaIA APP Backend
# ==============================================================================
ENVIRONMENT=development
PROJECT_NAME="RosaIA APP — Backend API (UNICEPLAC)"
API_V1_STR=/api/v1

# Banco de dados PostgreSQL com asyncpg (Neon.tech ou Supabase)
DATABASE_URL=postgresql+asyncpg://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/rosaia?ssl=require

# Segurança Criptográfica & LGPD
SECRET_KEY=sua-chave-secreta-jwt-super-segura-minimo-32-chars
BLIND_INDEX_SALT=salt-secreto-para-hmac-sha256-do-cpf-uniceplac
CPF_AES_KEY=chave-aes-256-gcm-ou-fernet-para-cifrar-cpf-em-repouso

# Google AI Studio (Gemini 3.1 Flash Lite / Embeddings 768-dim)
GEMINI_API_KEY=AIzaSy_SuaChaveDoGoogleAIStudioAqui
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-3-flash-preview

# CORS (Frontend Vercel + Localhost)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "https://*.vercel.app"]
